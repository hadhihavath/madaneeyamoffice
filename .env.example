# Database Connection String (Supabase PostgreSQL / Hostinger PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname"

# Production Authentication Secret (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-secure-random-256-bit-hex-key"

# Demo Mode (Strictly "false" in production)
ENABLE_DEMO_MODE="false"
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# Server Port (Default is 3000)
PORT=3000
NODE_ENV="production"
